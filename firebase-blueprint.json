{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile with role, status, and authentication details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500000 },
        "role": { "type": "string", "enum": ["superadmin", "admin", "model", "client", "empresa"] },
        "status": { "type": "string", "enum": ["active", "standby", "suspended"] },
        "requestedRole": { "type": "string", "enum": ["client", "model", "empresa"] },
        "clientType": { "type": "string", "enum": ["empresa", "particular"] },
        "companyName": { "type": "string", "maxLength": 150 },
        "companyRif": { "type": "string", "maxLength": 50 },
        "twoFactorEnabled": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "activatedAt": { "type": "string", "maxLength": 50 },
        "activatedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "model": {
      "title": "ModelProfile",
      "description": "Talent profile in Venezuela with rates, mediakit, and identity verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 100 },
        "stageName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["promotora", "pasarela", "fotografia", "hostess", "streaming"] },
        "categoryLabel": { "type": "string", "maxLength": 100 },
        "roleLabel": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "isVip": { "type": "boolean" },
        "isPaused": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "dailyRate": { "type": "number" },
        "avatar": { "type": "string", "maxLength": 500000 },
        "bio": { "type": "string", "maxLength": 1000 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["activa", "pausada", "en_evento"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "category", "verified", "isPaused", "hourlyRate", "dailyRate"]
    },
    "review": {
      "title": "Review",
      "description": "Client rating and verified feedback for a model",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "modelId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorCompany": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "comment": { "type": "string", "maxLength": 1000 },
        "verifiedBooking": { "type": "boolean" }
      },
      "required": ["id", "modelId", "authorName", "rating", "comment"]
    },
    "event": {
      "title": "EventItem",
      "description": "Promoted brand activations and events in Venezuela",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "tagline": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["upcoming", "casting_open", "completed"] },
        "organizer": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "date", "location", "status"]
    },
    "config": {
      "title": "AgencyConfig",
      "description": "Global agency branding, cities, and live stream settings",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "maxLength": 30 },
        "brandName": { "type": "string", "maxLength": 100 }
      }
    },
    "wallPost": {
      "title": "WallPost",
      "description": "Daily social post on Para Ti wall with reactions and comments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "enum": ["superadmin", "admin", "model", "client", "empresa"] },
        "text": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "createdDateString": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "authorId", "authorName", "text", "createdDateString"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Registered user accounts with role and preferences"
    },
    "/models/{modelId}": {
      "schema": "model",
      "description": "Model profiles catalog and verified status"
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Model reviews and scores"
    },
    "/events/{eventId}": {
      "schema": "event",
      "description": "Events and casting calls"
    },
    "/config/{configId}": {
      "schema": "config",
      "description": "Global branding and settings configuration"
    },
    "/wall/{postId}": {
      "schema": "wallPost",
      "description": "Real-time social wall posts with photo, text, reactions, and comments"
    }
  }
}
