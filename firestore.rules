rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'pixelglez1988@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health check connection test document
    match /test/connection {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Models Collection (Catalogo de Modelos Venezuela)
    match /models/{modelId} {
      // Anyone can view unpaused models or if superadmin/owner
      allow get: if isValidId(modelId);
      allow list: if true;
      
      // Creation restricted to superadmin or authenticated model user
      allow create: if isSuperAdmin() || (isVerified() && incoming().ownerEmail == request.auth.token.email);

      // Super Admin can update anything (including rates & identity verification)
      // Models can update their own data but cannot modify rates or self-validate identity
      allow update: if isSuperAdmin() || (
        isVerified() &&
        existing().ownerEmail == request.auth.token.email &&
        incoming().ownerEmail == existing().ownerEmail &&
        incoming().hourlyRate == existing().hourlyRate &&
        incoming().dailyRate == existing().dailyRate &&
        incoming().verified == existing().verified
      );

      allow delete: if isSuperAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isValidId(eventId);
      allow list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Direct Chats Collection
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
