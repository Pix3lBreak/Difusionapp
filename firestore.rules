rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'pixelglez1988@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health check connection test document
    match /test/connection {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users Collection (Persists user roles, standby, and suspended states)
    match /users/{userId} {
      allow get: if isSuperAdmin() || (isSignedIn() && (isOwner(userId) || request.auth.token.email.lower() == resource.data.email.lower()));
      allow list: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isOwner(userId) || (isSignedIn() && request.auth.token.email.lower() == resource.data.email.lower());
      allow delete: if isSuperAdmin();
    }

    // Models Collection (Catalogo de Modelos Venezuela)
    match /models/{modelId} {
      allow get: if isValidId(modelId);
      allow list: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && incoming().ownerEmail.lower() == request.auth.token.email.lower());
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        existing().ownerEmail.lower() == request.auth.token.email.lower() &&
        (!('ownerEmail' in incoming()) || incoming().ownerEmail.lower() == existing().ownerEmail.lower()) &&
        (!('verified' in incoming()) || incoming().verified == existing().verified)
      );
      allow delete: if isSuperAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if isValidId(eventId);
      allow list: if true;
      allow create: if isSuperAdmin() || isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Agency Theme and Global Configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Real-Time Social Wall ("Para Ti") - Restricted to Authenticated Users
    match /wall/{postId} {
      allow read: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Direct Chats Collection
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
